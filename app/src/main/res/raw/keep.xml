<?xml version="1.0" encoding="utf-8"?>
<!--
    Wallpapers are looked up by name at runtime (Resources.getIdentifier("wp_<id>", ...)), which the resource shrinker
    cannot see. Without this rule a release build would silently drop them.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/wp_*"
    tools:shrinkMode="safe" />
